<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UserLandingPage">

    <!--Top border-->
    <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:background="@color/light_blue"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <TextView
                android:id="@+id/editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Welcome Username (fix w/ actual username)"
                android:textColor="@color/dark_blue"
                android:textSize="18sp"
                android:textStyle="bold" />
    </LinearLayout>

    <!--Bottom Border-->
    <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@color/dark_blue"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

        <Button
                android:id="@+id/newTripBtn"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/light_blue"
                android:gravity="center"
                android:text="@string/new_trip"
                android:textColor="@color/dark_blue" />

        <Button
                android:id="@+id/toolsBtn"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/light_blue"
                android:text="@string/tools"
                android:textColor="@color/dark_blue"
                android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!--Trips-->
    <LinearLayout
            android:id="@+id/addTripPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

        <EditText
                android:id="@+id/inputLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Trip Name / Location" />

        <EditText
                android:id="@+id/inputStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Start Date (e.g. 2023-10-01)"
                android:inputType="date" />

        <EditText
                android:id="@+id/inputEndDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="End Date (e.g. 2023-10-10)"
                android:inputType="date" />

        <Button
                android:id="@+id/saveTripBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Trip" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tripRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/addTripPanel" />

</androidx.constraintlayout.widget.ConstraintLayout>